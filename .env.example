SECRET_KEY=change_this_to_a_long_random_string

# Database driver: "mysql" for XAMPP/MySQL, "sqlite" to run with no DB server
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=civicpulse

# Optional. Without it the app falls back to its deterministic analysis engine.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Civic engine tuning (safe defaults, override only if you need to)
CLUSTER_RADIUS_M=120
CLUSTER_WINDOW_DAYS=30
CLUSTER_MIN_SCORE=0.55
ESCALATION_HOURS=48
